{
  "name": "focus-flow",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "db": "npm run db --workspace backend",
    "build": "npm run build --workspace frontend",
    "lint": "oxlint --config frontend/.oxlintrc.json frontend/src backend",
    "test": "npm test --workspace backend",
    "start": "npm start --workspace backend",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "@playwright/test": "^1.58.0"
  }
}
